NAKAMA_SERVER_KEY=raceglyph_mobile_protocol_4

NAKAMA_SESSION_ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_SESSION_64_HEX
NAKAMA_REFRESH_ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_REFRESH_64_HEX
NAKAMA_RUNTIME_HTTP_KEY=CHANGE_ME_PRODUCTION_RUNTIME_64_HEX
NAKAMA_CONSOLE_USERNAME=raceglyph_admin
