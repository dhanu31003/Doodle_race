; Engine configuration file.
; Edit through Godot where practical; keep release-critical settings reviewable here.
config_version=5

[application]

config/name="RaceGlyph"
config/description="Draw a circuit. Shape the race."
config/version="0.2.0"
run/main_scene="res://game/ui/main.tscn"
config/auto_accept_quit=false
config/icon="res://assets/final/brand/raceglyph_mark.svg"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.0275, 0.0627, 0.1216, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/final/brand/raceglyph_boot_splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]

Audio="*res://game/audio/audio_manager.gd"
GameServices="*res://game/app/game_services.gd"
NetworkSession="*res://game/network/client/private_multiplayer_session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.0196, 0.0275, 0.0471, 1)

[audio]

driver/enable_input=false
default_bus_layout="res://game/audio/default_bus_layout.tres"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[internationalization]

locale/fallback="en"

[debug]

gdscript/warnings/unassigned_variable_op_assign=1
gdscript/warnings/untyped_declaration=1
